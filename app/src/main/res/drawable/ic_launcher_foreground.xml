<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ходящий ребёнок: пиктограмма из простых обводок с круглыми концами
         вместо кривых bezier-заплаток — на маленьком размере значка это
         читается ровнее и не "плывёт". -->

    <!-- Голова: намеренно крупнее, чем у взрослого — у ребёнка голова
         занимает бОльшую долю роста, это и читается как "ребёнок", а не
         обобщённый пешеход -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,26 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 Z" />

    <!-- Корпус: небольшой наклон вперёд, как на шаге -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,38 L51,58" />

    <!-- Рука, уходящая назад -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M52,44 L64,49 L74,43" />

    <!-- Рука, уходящая вперёд -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M52,44 L40,39 L30,45" />

    <!-- Нога впереди, согнута в колене -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M51,58 L60,70 L62,88" />

    <!-- Нога сзади, вытянута назад -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M51,58 L42,74 L34,86" />

    <!-- Следы под задней ногой: смысл приложения — шаги -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5"
        android:pathData="M23,93 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.3"
        android:pathData="M14,85 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />
</vector>
